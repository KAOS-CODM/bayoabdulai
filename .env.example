# Bayo Portfolio - environment template (safe to commit; copy to .env)

# --- Core ---
NODE_ENV=development
PORT=3000

# --- Optional DNS override for mongodb+srv SRV lookups ---
# Set only if your local DNS breaks c-ares resolution (comma-separated IPs).
DNS_SERVERS=

# --- MongoDB (Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/
MONGODB_DB_NAME=bayo-portfolio

# --- Server-side sessions ---
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=8

# --- Public site base URL (SEO: canonical + Open Graph) ---
SITE_URL=http://localhost:3000

# --- Admin account (seeded; no public registration) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Cloudinary (server-side only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
