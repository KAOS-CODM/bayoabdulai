{
  "name": "bayo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bayo Abdulai Badmus portfolio - dynamic projects system (Express + MongoDB + Cloudinary)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --env-file-if-exists=.env --test --test-force-exit \"test/*.test.js\"",
    "build": "npm --prefix tailwind-workspace run build",
    "watch:css": "npm --prefix tailwind-workspace run watch",
    "seed:admin": "node --env-file-if-exists=.env server/scripts/seed-admin.js",
    "live:uploads": "node --env-file-if-exists=.env server/scripts/live-upload-check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  }
}
